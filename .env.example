# Copia este archivo como .env.local y completa los datos del proyecto de Supabase
# (Project Settings → API Keys). Sin ellos, la app guarda todo en este navegador.
# La clave publicable es pública por diseño. NUNCA pongas acá la clave secreta (sb_secret_…).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Símbolo de moneda que se muestra en precios.
VITE_CURRENCY=$
